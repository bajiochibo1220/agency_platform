# Import into BACKEND hosting environment (Render). Fill credentials yourself.
# Use the Neon connection string exactly as supplied, including SSL parameters.
# postgresql://USER:URL_ENCODED_PASSWORD@ep-YOUR-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_STORAGE=cloudinary
ENVIRONMENT=development
LOCAL_DEVELOPMENT=false
ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
# Backend origin used by Next.js on the frontend host; never include credentials.
BACKEND_URL=http://127.0.0.1:8100
# Optional one-time admin bootstrap. Prefer the interactive create-admin command.
ADMIN_EMAIL=
ADMIN_PASSWORD=
